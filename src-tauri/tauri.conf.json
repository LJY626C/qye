{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "Smart Website Builder",
  "version": "1.0.0",
  "identifier": "com.smartwebsitebuilder.app",
  "build": {
    "frontendDevUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "智能建站系统",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "permissions": [
    "core:app:allow-app-version",
    "core:dialog:allow-save",
    "core:fs:allow-all",
    "core:path:allow-all",
    "core:os:allow-info"
  ]
}